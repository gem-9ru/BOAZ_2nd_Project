  "semantic": {
    "tone": {
      "bg": {
        "$value": "{primitive.color.cream.100}",
        "$type": "color",
        "$description": "페이지 바탕"
      },
      "surface": {
        "$value": "{primitive.color.paper.50}",
        "$type": "color",
        "$description": "카드 바탕"
      },
      "surface-sunk": {
        "$value": "{primitive.color.sand.100}",
        "$type": "color",
        "$description": "막대의 빈 부분, 눌린 칸"
      },
      "ink": {
        "$value": "{primitive.color.navy.900}",
        "$type": "color",
        "$description": "본문·숫자"
      },
      "ink-soft": {
        "$value": "{primitive.color.slate.600}",
        "$type": "color",
        "$description": "보조 글자 (대비 7:1)"
      },
      "line": {
        "$value": "{primitive.color.sand.200}",
        "$type": "color"
      },
      "accent": {
        "$value": "{primitive.color.orange.400}",
        "$type": "color",
        "$description": "강조 장식·초점 링 (글자에는 쓰지 않음)"
      },
      "accent-ink": {
        "$value": "{primitive.color.orange.800}",
        "$type": "color",
        "$description": "강조 글자·링크 (대비 6:1)"
      },
      "action": {
        "$value": "{primitive.color.navy.900}",
        "$type": "color",
        "$description": "주 버튼"
      },
      "action-hover": {
        "$value": "{primitive.color.navy.700}",
        "$type": "color"
      },
      "on-action": {
        "$value": "{primitive.color.paper.50}",
        "$type": "color"
      },
      "series-a": {
        "$value": "{primitive.color.blue.600}",
        "$type": "color",
        "$description": "차트 A (dataviz 검사 통과)"
      },
      "series-b": {
        "$value": "{primitive.color.orange.600}",
        "$type": "color",
        "$description": "차트 B (대비 3:1 미만 → 항상 글자 함께)"
      },
      "adopt": {
        "$value": "{primitive.color.green.700}",
        "$type": "color",
        "$description": "판정: 채택 (90% 이상)"
      },
      "adopt-bg": {
        "$value": "{primitive.color.green.50}",
        "$type": "color"
      },
      "likely": {
        "$value": "{primitive.color.amber.700}",
        "$type": "color",
        "$description": "판정: 유력 (70~90%)"
      },
      "likely-bg": {
        "$value": "{primitive.color.amber.50}",
        "$type": "color"
      },
      "hold": {
        "$value": "{primitive.color.gray.600}",
        "$type": "color",
        "$description": "판정: 보류 (70% 미만)"
      },
      "hold-bg": {
        "$value": "{primitive.color.gray.50}",
        "$type": "color"
      },
      "warn": {
        "$value": "{primitive.color.orange.800}",
        "$type": "color",
        "$description": "게재 이상·빠진 열 경고 글자"
      },
      "warn-bg": {
        "$value": "{primitive.color.orange.50}",
        "$type": "color"
      },
      "info-bg": {
        "$value": "{primitive.color.blue.50}",
        "$type": "color"
      }
    },
    "space": {
      "inline": {
        "$value": "{primitive.size.2}",
        "$type": "dimension"
      },
      "stack": {
        "$value": "{primitive.size.4}",
        "$type": "dimension"
      },
      "section": {
        "$value": "{primitive.size.12}",
        "$type": "dimension"
      },
      "group": {
        "$value": "{primitive.size.8}",
        "$type": "dimension"
      }
    }
  },
  "component": {
    "card": {
      "bg": {
        "$value": "{semantic.tone.surface}",
        "$type": "color"
      },
      "border": {
        "$value": "{semantic.tone.line}",
        "$type": "color"
      },
      "radius": {
        "$value": "{primitive.radius.lg}",
        "$type": "dimension"
      },
      "padding": {
        "$value": "{primitive.size.6}",
        "$type": "dimension"
      }
    },
    "button": {
      "bg": {
        "$value": "{semantic.tone.action}",
        "$type": "color"
      },
      "fg": {
        "$value": "{semantic.tone.on-action}",
        "$type": "color"
      },
      "hover-bg": {
        "$value": "{semantic.tone.action-hover}",
        "$type": "color"
      },
      "radius": {
        "$value": "{primitive.radius.md}",
        "$type": "dimension"
      },
      "height": {
        "$value": "{primitive.size.12}",
        "$type": "dimension"
      }
    },
    "badge": {
      "radius": {
        "$value": "{primitive.radius.full}",
        "$type": "dimension"
      }
    },
    "details": {
      "summary-fg": {
        "$value": "{semantic.tone.accent-ink}",
        "$type": "color",
        "$description": "'이 숫자는 어떻게 나왔나요?' 접기"
      },
      "bg": {
        "$value": "{semantic.tone.bg}",
        "$type": "color"
      }
    },
    "banner": {
      "bg": {
        "$value": "{semantic.tone.warn-bg}",
        "$type": "color"
      },
      "fg": {
        "$value": "{semantic.tone.warn}",
        "$type": "color"
      }
    },
    "focus": {
      "ring": {
        "$value": "{semantic.tone.accent}",
        "$type": "color"
      }
    }
