# Streamlit Community Cloud → 앱 Settings → Secrets 에 아래 세 줄을 붙여 넣습니다.
# (로컬에서는 프로젝트 루트 .env 를 쓰므로 이 파일은 필요 없습니다. 실제 키를 이 파일에 쓰지 마세요.)
NAVER_AD_API_KEY = "..."
NAVER_AD_SECRET_KEY = "..."
NAVER_AD_CUSTOMER_ID = "..."

# NAVER API HUB (네이버 클라우드 콘솔 > NAVER API HUB > Application > 인증 정보): 데이터랩 검색어 트렌드·쇼핑 인사이트
NAVER_HUB_CLIENT_ID = "..."
NAVER_HUB_CLIENT_SECRET = "..."
